+/// regression tool only: whether `SSD_OVERLAY_LOG` is set.
+fn overlay_log() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("SSD_OVERLAY_LOG").is_some())
+}
+
+/// regression tool only: [`presence_in_window`] of the pages a frame may draw, measured and not
+/// used: the page named, the pages the overlay keeps (shown, behind) and the last six pages named (their English as
+/// when last named). Each `KEY=STATE,own,blank,other,skipped,letters,dx,dy,pitch,matched,x,y,misses;` with STATE
+/// `IN`, `COV`, `EMPTY`, `OUT` or `NONE`, dx and dy from where the engine writes (x, y the 1x pixel of the first line's
+/// first cell), and misses `line.cell.EE.GOT` joined by
+/// `+` (EE the English's code point in hex; GOT another character's code point, `C` a card tile, `B` a blank cell
+/// of another ground, `N` no text cell).
+fn presence_log(
+    t: &Translator,
+    cells: &[TextCell],
+    frame: &crate::Frame,
+    window_x: i32,
+    character: &dyn Fn(u8) -> Option<char>,
+) -> String {
+    use std::fmt::Write as _;
+    thread_local! {
+        static RECENT: std::cell::RefCell<Vec<OnScreen>> = const { std::cell::RefCell::new(Vec::new()) };
+    }
+    RECENT.with(|recent| {
+        let mut recent = recent.borrow_mut();
+        let named = t.screen.as_ref().filter(|s| !s.english.is_empty());
+        if let Some(s) = named {
+            recent.retain(|o| o.key != s.key);
+            recent.insert(0, s.clone());
+            recent.truncate(6);
+        }
+        let kept: Vec<&Kept> = std::iter::once(&t.kept).chain(t.behind.as_ref()).collect();
+        let mut keys: Vec<String> = Vec::new();
+        let candidates = named
+            .map(|s| s.key.clone())
+            .into_iter()
+            .chain(kept.iter().filter_map(|k| k.shown.as_ref().map(|s| s.key.clone())))
+            .chain(recent.iter().map(|s| s.key.clone()));
+        for key in candidates {
+            if !keys.contains(&key) {
+                keys.push(key);
+            }
+        }
+        let height = (frame.pixels.len() / frame.width.max(1)) as i32;
+        let mut out = String::new();
+        for key in keys {
+            if t.overlay.table.text(&key).is_none() {
+                continue;
+            }
+            let Some(screen) = named.filter(|s| s.key == key).or_else(|| recent.iter().find(|s| s.key == key))
+            else {
+                continue;
+            };
+            let owner = kept.iter().find(|k| k.shown.as_ref().is_some_and(|s| s.key == key));
+            let paper = owner.and_then(|k| k.colours).map(|c| c.1);
+            let hint = owner
+                .and_then(|k| k.place)
+                .filter(|p| p.string == (screen.table, screen.string))
+                .map(|p| (p.at, p.pitch));
+            let seen = presence_in_window(screen, cells, character, window_x, (frame.width as i32, height), paper, hint);
+            let state = match seen.presence {
+                Presence::In => "IN",
+                Presence::Covered => "COV",
+                Presence::Empty => "EMPTY",
+                Presence::Out => "OUT",
+                Presence::NoCells => "NONE",
+            };
+            let (column, row) = screen.base_cell();
+            let (dx, dy) = (seen.at.0 - window_x - 8 * i32::from(column), seen.at.1 - 8 * i32::from(row));
+            let misses: Vec<String> = seen
+                .misses
+                .iter()
+                .map(|&(line, cell, ch, miss)| {
+                    let got = match miss {
+                        Miss::Letter(c) => format!("{:x}", u32::from(c)),
+                        Miss::Card => "C".to_owned(),
+                        Miss::Ground => "B".to_owned(),
+                        Miss::Nothing => "N".to_owned(),
+                    };
+                    format!("{line}.{cell}.{:x}.{got}", u32::from(ch))
+                })
+                .collect();
+            let _ = write!(
+                out,
+                "{key}={state},{},{},{},{},{},{dx},{dy},{},{},{},{},{};",
+                seen.own,
+                seen.blank,
+                seen.other,
+                seen.skipped,
+                seen.letters,
+                seen.pitch,
+                u8::from(seen.matched),
+                seen.at.0,
+                seen.at.1,
+                misses.join("+")
+            );
+        }
+        out
+    })
 }
 
